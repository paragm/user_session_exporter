# User Sessions Exporter configuration
# Deploy to /etc/default/user-sessions-exporter on each monitored host

# Port to listen on (default: 10041)
PORT=10041

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Comma-separated list of usernames to exclude from per-user metrics
# System accounts with UID < 1000 are always excluded regardless of this list
EXCLUDE_USERS=nobody,daemon,www-data,zabbix,prometheus,grafana,postgres,mysql,redis,cadvisor
